# Copy to frontend/.env. These VITE_ values are baked into the built JS and are
# not secret (the Firebase web config is meant to be public), but keep them out
# of git anyway. On Vercel, set them in Project Settings -> Environment Variables.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Local dev only — points Vite at the separate backend process.
# Leave UNSET on Vercel so the app uses the same-origin "/api".
VITE_API_URL=http://localhost:4000/api
