# Copy to backend/.env and fill in. NEVER commit the real .env.
# On Vercel these are set in Project Settings -> Environment Variables instead.

PORT=4000

# Allowed browser origin(s), comma-separated. Only matters for local dev / a
# split deploy — on Vercel the frontend and API share an origin.
CLIENT_ORIGIN=http://localhost:5173

# The one permanent super admin (must match a real login — see src/data/sampleData.js)
SUPER_ADMIN_EMAIL=admin@example.com

# Firebase console -> Realtime Database -> the URL shown at the top
FIREBASE_DATABASE_URL=https://YOUR-PROJECT-default-rtdb.firebasedatabase.app

# Firebase console -> Project settings -> Service accounts -> Generate new
# private key. Copy these three fields out of the downloaded JSON.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Keep the quotes and the literal \n sequences.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
