# Port the Express API listens on
PORT=4000

# Your Vite dev server origin (for CORS)
CLIENT_ORIGIN=http://localhost:5173

# Firebase console -> Realtime Database -> copy the URL shown at the top
FIREBASE_DATABASE_URL=https://dashboard-fd12c-default-rtdb.asia-southeast1.firebasedatabase.app

# --- Service account credentials (server-side only, never expose to the frontend) ---
# Firebase console -> Project settings -> Service accounts -> Generate new private key.
# That downloads a JSON file — copy the three fields below out of it.
FIREBASE_PROJECT_ID=dashboard-fd12c
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@dashboard-fd12c.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
